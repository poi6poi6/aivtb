{
  "manifest_version": 3,
  "name": "AI VTuber 本地 B 站浏览助手",
  "version": "1.3.0",
  "minimum_chrome_version": "110",
  "description": "为本地 AI VTuber 查询视频、读取字幕与热评，并按开关和账号校验发布动态、点赞或评论；不导出 Cookie。",
  "permissions": ["storage"],
  "host_permissions": [
    "http://localhost/*", "http://127.0.0.1/*",
    "https://search.bilibili.com/*", "https://www.bilibili.com/video/*",
    "https://t.bilibili.com/*", "https://space.bilibili.com/*", "https://www.bilibili.com/opus/*",
    "https://api.bilibili.com/*", "https://aisubtitle.hdslb.com/*", "https://subtitle.hdslb.com/*",
    "https://i0.hdslb.com/*", "https://i1.hdslb.com/*", "https://i2.hdslb.com/*"
  ],
  "background": {"service_worker": "background.js"},
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*"],
      "js": ["common.js", "bridge.js", "activity.js", "activity-bridge.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["https://search.bilibili.com/*", "https://www.bilibili.com/video/*", "https://t.bilibili.com/*", "https://space.bilibili.com/*", "https://www.bilibili.com/opus/*"],
      "js": ["activity.js", "activity-interaction.js", "activity-content.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["https://search.bilibili.com/*", "https://www.bilibili.com/video/*"],
      "js": ["common.js", "collector.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
